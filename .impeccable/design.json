  "components": [
    {
      "name": "Accent Button",
      "kind": "button",
      "refersTo": "button-accent",
      "description": "The one turmeric primary action per screen.",
      "html": "<button class=\"ds-btn-accent\">Place order</button>",
      "css": ".ds-btn-accent{font-family:'Plus Jakarta Sans',Inter,sans-serif;min-height:52px;padding:0 24px;border:0;border-radius:999px;background:#F5A623;color:#15130F;font-weight:700;font-size:15px;cursor:pointer;transition:transform .18s cubic-bezier(.2,.9,.3,1.2),background .15s}.ds-btn-accent:hover{background:#FFC24D}.ds-btn-accent:active{transform:scale(.96)}.ds-btn-accent:focus-visible{outline:3px solid #15130F;outline-offset:2px}"
    },
    {
      "name": "Dark Button",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Secondary action, e.g. Call or Browse stalls.",
      "html": "<button class=\"ds-btn-dark\">Browse stalls</button>",
      "css": ".ds-btn-dark{font-family:'Plus Jakarta Sans',Inter,sans-serif;min-height:44px;padding:0 16px;border:0;border-radius:999px;background:#15130F;color:#fff;font-weight:700;font-size:14px;cursor:pointer;transition:transform .18s cubic-bezier(.2,.9,.3,1.2)}.ds-btn-dark:hover{background:#000}.ds-btn-dark:active{transform:scale(.96)}.ds-btn-dark:focus-visible{outline:3px solid #F5A623;outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Tertiary action, e.g. Chat.",
      "html": "<button class=\"ds-btn-outline\">Chat</button>",
      "css": ".ds-btn-outline{font-family:'Plus Jakarta Sans',Inter,sans-serif;min-height:44px;padding:0 16px;border:1.5px solid #ECE7DA;border-radius:999px;background:#fff;color:#15130F;font-weight:700;font-size:14px;cursor:pointer;transition:transform .18s cubic-bezier(.2,.9,.3,1.2),border-color .15s}.ds-btn-outline:hover{border-color:#C9C4B6}.ds-btn-outline:active{transform:scale(.96)}.ds-btn-outline:focus-visible{outline:3px solid #15130F;outline-offset:2px}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill filters; selected chip is ink with white text.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\">Nearby</button><button class=\"ds-chip\">Halal</button><button class=\"ds-chip\">Open now</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font-family:'Plus Jakarta Sans',Inter,sans-serif;min-height:34px;padding:7px 14px;border-radius:999px;border:1px solid #ECE7DA;background:#fff;color:#15130F;font-weight:600;font-size:12.5px;cursor:pointer}.ds-chip:hover{border-color:#C9C4B6}.ds-chip-on{background:#15130F;border-color:#15130F;color:#fff}.ds-chip:focus-visible{outline:3px solid #15130F;outline-offset:2px}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-success",
      "description": "Text-labelled status pills; colour is never the only cue.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge ds-ok\">Confirmed</span><span class=\"ds-badge ds-warn\">Awaiting stall</span><span class=\"ds-badge ds-bad\">Cancelled</span></div>",
      "css": ".ds-badges{display:flex;gap:8px}.ds-badge{font-family:'Plus Jakarta Sans',Inter,sans-serif;padding:4px 8px;border-radius:999px;font-weight:700;font-size:12px}.ds-ok{background:#EAF3EC;color:#2F6F4E}.ds-warn{background:#F3E4C4;color:#8A5200}.ds-bad{background:#F1DAD6;color:#AE2A1F}"
    },
    {
      "name": "Dish Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Bordered white card with circular photo, amber price and the round turmeric add button.",
      "html": "<div class=\"ds-dish\"><div class=\"ds-dish-img\"></div><div class=\"ds-dish-body\"><div class=\"ds-dish-name\">Nasi lemak ayam</div><div class=\"ds-dish-meta\">Sambal, egg, peanuts</div><div class=\"ds-dish-price\">RM 8.50</div></div><button class=\"ds-add\" aria-label=\"Add\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#15130F\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button></div>",
      "css": ".ds-dish{font-family:'Plus Jakarta Sans',Inter,sans-serif;display:flex;align-items:center;gap:12px;padding:12px;background:#fff;border:1px solid #ECE7DA;border-radius:16px;max-width:360px;transition:transform .18s}.ds-dish:active{transform:scale(.98)}.ds-dish-img{width:64px;height:64px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#FFC24D,#D9860B)}.ds-dish-body{flex:1}.ds-dish-name{font-weight:600;font-size:15px;color:#15130F}.ds-dish-meta{font-size:13px;color:#6B675F;margin:2px 0 4px}.ds-dish-price{font-weight:700;font-size:15px;color:#8A5200}.ds-add{width:30px;height:30px;border-radius:50%;border:0;background:#F5A623;display:grid;place-items:center;cursor:pointer;transition:transform .18s cubic-bezier(.2,.9,.3,1.2)}.ds-add:active{transform:scale(.9)}.ds-add:focus-visible{outline:3px solid #15130F;outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": null,
