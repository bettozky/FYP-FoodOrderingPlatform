{
  "name": "scootmeal-backend",
  "version": "1.0.0",
  "description": "ScootMeal backend (Node.js + TypeScript + Express), organised into modules.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "db:migrate": "tsx src/store/persistence/migrate.ts",
    "routes": "node scripts/routes.mjs",
    "db:check": "node scripts/check-database.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "openai": "^7.28.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
