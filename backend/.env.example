# Copy this file to .env and fill in what you need. Everything is optional: with an empty .env the server runs on
# in-memory demo data (resets on restart), which is fine for trying things out.

PORT=3001

# ---- Database: Supabase (or any PostgreSQL) ------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (works on every network).
# Replace [YOUR-PASSWORD] with your database password. See SUPABASE.md for the 5-minute setup.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=auto            # auto = SSL for hosted databases, off for localhost. true / false to force.
# SEED_DEMO_DATA=true          # put the demo shops and logins into an EMPTY database. Use false for a real launch.
# ADMIN_EMAIL=you@example.com  # creates this admin account on start-up if there is no admin yet
# ADMIN_PASSWORD=choose-a-long-password

# ---- Supabase Storage: photos and shop documents ---------------------------------------------------
# Project Settings -> API: the project URL and the SECRET key (service_role / sb_secret_...). Keep it private.
# Without these, uploads are saved in backend/public/uploads on this computer instead.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# SUPABASE_MENU_BUCKET=menu-photos
# SUPABASE_SHOP_BUCKET=shop-photos
# SUPABASE_DOCUMENT_BUCKET=merchant-documents
# SUPABASE_AVATAR_BUCKET=avatars                   # profile photos (public)
# SUPABASE_APPLICATION_BUCKET=job-applications     # job applicants' CVs and documents (private, opened by short-lived links)
# MAX_UPLOAD_MB=5                                  # largest photo / document accepted

# ---- Email: forgot-password codes ----------------------------------------------------------------
# Without SMTP_HOST the 6-digit code is only printed in the server console (fine for local testing).
# For real emails use any SMTP service (Gmail app password, Brevo, Resend SMTP, Mailgun ...).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=ScootMeal <you@gmail.com>
# RESET_CODE_MINUTES=15
# ENABLE_DEV_RESET=0           # leave off. Set to 1 only on your own PC to let the test scripts wipe the data. Never works in production.
# RESET_CODE_IN_RESPONSE=false   # TEST ONLY: returns the code in the API reply. Ignored when NODE_ENV=production.
# FILE_LINK_SECRET=long-random-text   # signs the 1-hour links to applicants' documents (set it if you run more than one server)

# ---- AI assistant ----------------------------------------------------------------------------------
OPENAI_API_KEY=your-key-here
# AI_MODEL=gpt-6-luna

# ---- Optional tuning -------------------------------------------------------------------------------
# SESSION_DAYS=30              # how long a login lasts
# PUBLIC_URL=https://api.example.com   # only if uploads are stored locally and the server is behind a proxy
# ORDER_RESPONSE_MS=600000     # merchant has 10 minutes to confirm an order
# PAYMENT_WINDOW_MS=600000     # customer has 10 minutes to pay after confirmation
# (more business rules and timers: see src/config/env.ts)
